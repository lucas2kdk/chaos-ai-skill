#!/usr/bin/env bash
# Poll /health for up to 15s; healthy as soon as it answers 200.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../../sandbox/lib.sh"
start=$(date +%s)
while (( $(date +%s) - start < 15 )); do
  read -r code secs < <(get /health 1)
  if [[ "$code" == 200 ]]; then echo "ok: GET /health -> 200 after $(( $(date +%s) - start ))s"; exit 0; fi
  echo "waiting: GET /health -> ${code:-000}"
  sleep 0.5
done
echo "VIOLATED: GET /health did not answer 200 within 15s"
exit 1
